# ==============================================================================
# Fileit — Environment Configuration Template
# Copy this file to .env or .env.local and update values accordingly.
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Database Configuration (PostgreSQL)
# Required for persistent files, rooms, and metadata storage
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fileit

# Alternative Direct PostgreSQL / CloudSQL credentials (if DATABASE_URL is not set)
# SQL_HOST=localhost
# SQL_USER=postgres
# SQL_PASSWORD=postgres
# SQL_DB_NAME=fileit

# Storage Configuration
# Options: "local" (default) or "supabase"
VITE_STORAGE_PROVIDER=local

# Supabase Storage Configuration (Optional - only required if VITE_STORAGE_PROVIDER=supabase)
# Backend (Server) Keys:
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# SUPABASE_STORAGE_BUCKET=fileit

# Frontend (Client) Keys:
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# VITE_SUPABASE_STORAGE_BUCKET=fileit

# Google Drive Integration (Optional - Firebase Auth)
# VITE_FIREBASE_API_KEY=your-firebase-api-key
# VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
# VITE_FIREBASE_APP_ID=your-firebase-app-id
# VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project.firebaseapp.com
# VITE_FIREBASE_STORAGE_BUCKET=your-firebase-project.firebasestorage.app
# VITE_FIREBASE_MESSAGING_SENDER_ID=your-firebase-messaging-sender-id
